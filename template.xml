  <body>
    <nav class="native-nav" aria-label="主导航"><div><a href="/">HOME</a><a href="/archives">ARCHIVES</a><a href="/pages">PAGES</a></div><div><form action="/search" method="get"><input aria-label="搜索文章" placeholder="搜索文章" name="q"/></form><div data-blogger-island="theme"></div></div></nav><main id="blogger-native"><b:section id='main' showaddelement='no' maxwidgets='1'><b:widget id='Blog1' type='Blog' locked='true' version='2' title='Blog Posts'><b:includable id='main' var='top'><b:if cond='data:view.isSingleItem'><b:loop values='data:posts' var='post'><div class="native-post-layout"><div data-blogger-island="toc"></div><article class="native-post" itemScope="" itemType="https://schema.org/BlogPosting"><header class="native-post-header"><h1 itemProp="headline"><data:post.title/></h1><div class="native-date">发布于 <time itemProp="datePublished" expr:datetime="data:post.timestampISO8601"><data:post.timestamp/></time></div><div class="native-tags"><b:loop values='data:post.labels' var='label'><a class="post-tag" expr:href="data:label.url"><data:label.name/></a></b:loop></div></header><div class="post-body entry-content blog-content" itemProp="articleBody" expr:id="&quot;post-body-&quot; + data:post.id"><data:post.body/></div><b:if cond='data:post.allowComments or data:post.numberOfComments > 0'><section id="comments" class="native-comments"><h3>评论区 <span>(<data:post.numberOfComments/>)</span></h3><b:loop values='data:post.comments' var='comment'><article class="native-comment" expr:id="&quot;c&quot; + data:comment.id"><header><b:if cond='data:comment.authorUrl'><a expr:href="data:comment.authorUrl" rel="nofollow noopener" target="_blank"><data:comment.author/></a><b:else/><data:comment.author/></b:if><a class="native-date" expr:href="data:comment.url"><data:comment.timestamp/></a></header><div class="native-comment-body"><data:comment.body/></div><b:if cond='data:post.allowNewComments'><a class="native-reply" expr:data-reply-id="data:comment.id" expr:href="data:post.addCommentUrl">回复</a></b:if></article></b:loop><b:if cond='data:post.commentPagingRequired'><nav class="native-pagination" aria-label="评论分页"><b:if cond='data:post.hasOlderLinks'><a expr:href="data:post.oldestLinkUrl">最早</a><a expr:href="data:post.olderLinkUrl">较早</a></b:if><span><data:post.commentRangeText/></span><b:if cond='data:post.hasNewerLinks'><a expr:href="data:post.newerLinkUrl">较新</a><a expr:href="data:post.newestLinkUrl">最新</a></b:if></nav></b:if><b:if cond='data:post.allowNewComments'><div data-blogger-island="comment-form" expr:data-editor-url="data:post.commentFormIframeSrc" expr:data-comment-url="data:post.addCommentUrl"></div><noscript><a expr:href="data:post.addCommentUrl">发表评论</a></noscript><b:else/><p><data:post.noNewCommentsText/></p></b:if></section></b:if></article></div></b:loop><b:else/><link rel="preload" as="image" href="https://s2.loli.net/2025/05/16/ke3yL5RDTOsU4vg.png"/><div class="native-home"><div class="native-home-main"><div data-blogger-island="site-title"><h1><data:blog.title/></h1><p>Outside of Scarlet</p></div><section class="native-post-list"><h2>最新文章</h2><b:loop values='data:posts' var='post'><article class="native-post-card"><a class="native-post-link" expr:href="data:post.url"><h3><data:post.title/></h3></a><div class="native-tags"><b:loop values='data:post.labels' var='label'><a class="post-tag" expr:href="data:label.url"><data:label.name/></a></b:loop></div><p class="native-summary"><b:eval expr='snippet(data:post.body, {length: 240, links: false, linebreaks: false})'/></p><div class="native-date">发布于 <data:post.timestamp/></div></article></b:loop><b:if cond='data:posts.empty'><p>暂无文章</p></b:if><nav class="native-pagination" aria-label="文章分页"><b:if cond='data:newerPageUrl'><a expr:href="data:newerPageUrl" rel="prev">较新的文章</a></b:if><a href="/">首页</a><b:if cond='data:olderPageUrl'><a expr:href="data:olderPageUrl" rel="next">更早的文章</a></b:if></nav></section></div><aside class="native-home-sidebar"><div data-blogger-island="slider"></div><section class="native-welcome"><h2><data:blog.title/></h2><p><data:blog.description/></p></section><img class="native-banner" src="https://s2.loli.net/2025/05/16/ke3yL5RDTOsU4vg.png" alt="绯境之外"/><div data-blogger-island="blogroll"></div></aside></div></b:if></b:includable></b:widget></b:section></main><footer class="native-footer"><div><strong><data:blog.title/></strong><div>© 2022 - 2026 Copyright 绯境之外</div><div>Theme by scarletborder</div><div>Powered by Blogger and React</div></div><div><strong>联系方式</strong><div>邮箱: baishuibeef@gmail.com</div><div>scarletborder / 黯界绯</div></div></footer>
